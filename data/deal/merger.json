     "tasks": [
      [
       "Map Stripe ids and integer ids to UUIDs in one table",
       "priya",
       "leo",
       "2027-06-15"
      ]
     ],
     "measure": "Every customer resolves to one UUID"
    },
    "q3": {
     "goal": "One billing team",
     "tasks": [
      [
       "Merge billing teams; Priya leads, Leo deputy",
       "marcus",
