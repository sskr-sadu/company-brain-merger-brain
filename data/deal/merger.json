 "pairs": [
  {
   "id": "P1",
   "ng": "ng:org/eng/platform",
   "pp": "pp:org/eng/core",
   "mode": "Align, then merge identity",
   "fused": {
    "id": "fz:org/eng/identity-core",
    "name": "Identity & Core Platform",
    "lead": "wei",
    "deputy": "sofia",
    "quarter": "q3"
   },
   "why": "Both own the identity service. Northgate uses integer user ids moving to UUIDs (Identity v2); Pulsepoint is already on UUIDs.",
   "contract": [
    "Platform publishes Identity v2 UUID format and dates to Core by Feb 15",
    "Core shares its UUID migration runbook with Platform",
    "No breaking change to either identity API without a 1-train notice to the other team"
   ],
   "rituals": [
    "#pair-identity shared channel from Day 1",
    "Weekly 30-min sync, Thursdays, alternating host",
    "Buddy pairs: Tom \u2194 Ben, Wei \u2194 Sofia",
    "Joint architecture review once a month from Q2",
    "Joint on-call shadowing from Q2, shared rotation from Q3"
   ],
   "bridge": "The owner decides, but posts the decision in #pair-identity 48 hours before acting",
   "quarters": {
    "q1": {
     "goal": "Understand each other's identity model",
     "tasks": [
      [
       "Exchange team cards and the identity data model",
       "wei",
       "sofia",
       "2027-01-22"
      ],
      [
       "Compare UUID formats and write the gap list",
       "tom",
       "ben",
       "2027-02-26"
      ],
      [
       "Sign the pair contract",
       "wei",
       "sofia",
       "2027-02-05"
      ]
     ],
     "measure": "Gap list agreed; contract signed"
    },
    "q2": {
     "goal": "One UUID format for both products",
     "tasks": [
      [
       "Adopt Pulsepoint's UUID format in Identity v2",
       "wei",
       "sofia",
       "2027-05-14"
      ],
      [
       "Shadow each other's on-call for 2 weeks",
       "tom",
       "ben",
       "2027-06-11"
      ]
     ],
     "measure": "Both identity services issue the same UUID format"
    },
    "q3": {
     "goal": "One identity service and one team",
     "tasks": [
      [
       "Merge identity services behind one API",
       "wei",
       "sofia",
       "2027-09-10"
      ],
      [
       "Form Identity & Core Platform team; Wei leads, Sofia deputy",
       "marcus",
       "aisha",
       "2027-07-15"
      ]
     ],
     "measure": "One identity service in production; one backlog"
    },
    "q4": {
     "goal": "Run as one team",
     "tasks": [
      [
       "Retire the old Pulsepoint identity endpoints",
       "sofia",
       "wei",
       "2027-11-30"
      ]
     ],
     "measure": "No traffic on retired endpoints"
    }
   }
  },
  {
   "id": "P2",
   "ng": "ng:org/eng/billing",
   "pp": "pp:org/eng/billing",
   "mode": "Remove key-person risk, then merge",
   "fused": {
    "id": "fz:org/eng/billing",
    "name": "Billing",
    "lead": "priya",
    "deputy": "leo",
    "quarter": "q3"
   },
   "why": "Pulsepoint billing is built and run by one engineer (Leo Martins). Northgate invoices from integer user ids; Pulsepoint maps Stripe ids to UUIDs.",
   "contract": [
    "Leo pairs with a Northgate billing engineer on every billing deploy in Q1",
    "Billing changes on either side need a reviewer from the other team from Q2",
    "Invoice formats stay unchanged for customers until Q4"
   ],
   "rituals": [
    "#pair-billing shared channel",
    "Twice-weekly 20-min sync in Q1 (knowledge transfer), weekly after",
    "Pair-programming days every other Friday",
    "Shared runbook in the pair space"
   ],
   "bridge": "Two people can deploy billing on either side; nobody deploys billing alone",
   "quarters": {
    "q1": {
     "goal": "A second engineer can run Pulsepoint billing",
     "tasks": [
      [
       "Second engineer trained on Pulsepoint billing (T-02)",
       "priya",
