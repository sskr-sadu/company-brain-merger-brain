 "plan_options": {
  "pre": [
   [
    "Absorb",
    "Pulsepoint adopts Northgate's processes and tools within two quarters.",
    "Fast and simple; high risk of losing Pulsepoint's speed and key people."
   ],
   [
    "Co-create",
    "Keep what works on each side; decide each clash together on a schedule; fuse at year end.",
    "Keeps people and customers; needs disciplined tracking (the brain does this).",
    true
   ],
   [
    "Keep separate",
    "Run Pulsepoint as a standalone unit with only finance and security joined.",
    "Lowest risk; few synergies."
   ]
  ],
  "q1": [
   [
    "Stabilize with light pairs",
    "Run as two companies; pair teams to learn each other; only legal, security and shared-customer work is joint.",
    "Protects value; integration starts slowly.",
    true
   ],
   [
    "Early merge of engineering",
    "Merge engineering teams in Q1.",
    "Faster synergies; high attrition risk."
   ]
  ],
  "q2": [
   [
    "Align definitions and tools",
    "One CRM, one churn metric, one set of policies; teams still separate.",
    "Clear numbers for the board; tool migration load on Sales.",
    true
   ],
   [
    "Defer tools to Q3",
    "Align only metrics and policies.",
    "Less disruption; two CRMs for longer."
   ]
  ],
  "q3": [
   [
    "Merge paired teams in order",
    "Billing, then Identity/Core, then People; one charter for decisions.",
    "Real integration with checks per unit.",
    true
   ],
   [
    "Merge all at once",
    "Every pair merges on Jul 1.",
    "One change moment; no time to learn from the first merge."
   ]
  ],
  "q4": [
   [
    "Fuse unit by unit, final cut Dec 31",
    "Remaining units fused; one brain with origin tags.",
    "Traceable; takes the whole quarter.",
    true
   ]
  ]
 },
