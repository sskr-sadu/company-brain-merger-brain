       "2027-03-31"
      ],
      [
       "Write the Pulsepoint billing runbook",
       "leo",
       "priya",
       "2027-02-28"
      ]
     ],
     "measure": "A Northgate engineer has deployed Pulsepoint billing twice, unassisted"
    },
    "q2": {
