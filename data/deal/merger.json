   "mode": "One release process, decided together",
   "fused": {
    "id": "fz:org/eng",
    "name": "Engineering",
    "lead": "marcus",
    "deputy": "aisha",
    "quarter": "q4"
   },
   "why": "Northgate ships on a quarterly release train; Pulsepoint deploys continuously. Both require a security review (same rule, different words).",
   "contract": [
    "Healthcare customers get Northgate's security review and audit log on every Pulsepoint deploy from Q1",
    "The release process is decided in the joint decision charter by Q3"
   ],
   "rituals": [
    "Monthly engineering leads forum, both companies",
    "Shared incident reviews from Q1",
    "Joint decision charter working group (T-08)"
   ],
   "bridge": "Decisions are made by a named owner after the affected teams have had 48 hours to comment",
   "quarters": {
